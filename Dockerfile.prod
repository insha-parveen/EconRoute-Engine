# ─── EconRoute Production Dockerfile ─────────────────────────────────────────
# Multi-stage build: smaller final image, no dev dependencies, no --reload.
#
# Stage 1: Builder — install deps and pre-download models
# Stage 2: Runtime — minimal image with only what's needed

# ─── Stage 1: Builder ────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-locked.txt ./

# No torch needed — fastembed runs ONNX Runtime CPU (installed as its dep).
RUN pip install --no-cache-dir --timeout 120 --retries 5 -r requirements-locked.txt

# Pre-download ONNX embedding model at build time
# fastembed uses its own FASTEMBED_CACHE_PATH (not HF_HOME) — set it so the
# baked cache is the same path the runtime reads. No re-download at boot.
ENV FASTEMBED_CACHE_PATH=/app/.cache/fastembed
ENV HF_HOME=/app/.cache/huggingface
ENV HF_HUB_DISABLE_TELEMETRY=1
ENV OMP_NUM_THREADS=1
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('sentence-transformers/all-MiniLM-L6-v2', threads=1)"

COPY . .

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code + cached models
COPY --from=builder /app /app

# Create non-root user
RUN useradd -m -u 1000 econroute && chown -R econroute:econroute /app
USER econroute

EXPOSE 8000

# Use PORT env var if set (Render), fallback to 8000
CMD exec uvicorn gateway.main:app --host 0.0.0.0 --port ${PORT:-8000}
